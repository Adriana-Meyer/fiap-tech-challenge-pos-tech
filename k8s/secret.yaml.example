# Template de referência — NÃO é aplicado diretamente.
# O Secret real é criado via `kubectl create secret generic`
# (deploy-aws.yml), com os valores vindos dos GitHub Secrets
# (JWT_SECRET, WEBHOOK_TOKEN, RDS_DATASOURCE_URL, RDS_USERNAME,
# RDS_PASSWORD, NEW_RELIC_LICENSE_KEY — os 3 do RDS copiados do
# `terraform output` do Repositório 3), nunca commitado com valores reais.
apiVersion: v1
kind: Secret
metadata:
  name: app-secret
  namespace: workshop
type: Opaque
stringData:
  JWT_SECRET: CHANGE_ME
  WEBHOOK_TOKEN: CHANGE_ME
  SPRING_DATASOURCE_URL: "jdbc:mysql://CHANGE_ME.rds.amazonaws.com:3306/workshop_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true"
  SPRING_DATASOURCE_USERNAME: CHANGE_ME
  SPRING_DATASOURCE_PASSWORD: CHANGE_ME
  NEW_RELIC_LICENSE_KEY: CHANGE_ME
