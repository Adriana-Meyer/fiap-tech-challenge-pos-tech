# Template de referência — NÃO é aplicado diretamente.
# O Secret real é criado via `kubectl create secret generic` (documentado README), nunca commitado com valores reais.
apiVersion: v1
kind: Secret
metadata:
  name: app-secret
  namespace: workshop
type: Opaque
stringData:
  JWT_SECRET: CHANGE_ME
  WEBHOOK_TOKEN: CHANGE_ME
  SPRING_DATASOURCE_USERNAME: CHANGE_ME
  SPRING_DATASOURCE_PASSWORD: CHANGE_ME
