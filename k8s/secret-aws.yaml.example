# Template de referência — NÃO é aplicado diretamente.
# No caminho AWS (deploy-aws.yml), o Secret real é criado via
# `kubectl create secret generic`, com os valores vindos dos GitHub
# Secrets (JWT_SECRET, WEBHOOK_TOKEN, RDS_DATASOURCE_URL, RDS_USERNAME,
# RDS_PASSWORD — os 3 últimos copiados do `terraform output` do
# Repositório 3), nunca commitado com valores reais.
#
# Difere de secret.yaml.example (usado pelo caminho kind/local) só por
# incluir SPRING_DATASOURCE_URL, necessário porque o RDS não tem o
# hostname fixo "mysql" que o Service em cluster tinha.
apiVersion: v1
kind: Secret
metadata:
  name: app-secret
  namespace: workshop
type: Opaque
stringData:
  JWT_SECRET: CHANGE_ME
  WEBHOOK_TOKEN: CHANGE_ME
  SPRING_DATASOURCE_URL: "jdbc:mysql://CHANGE_ME.rds.amazonaws.com:3306/workshop_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true"
  SPRING_DATASOURCE_USERNAME: CHANGE_ME
  SPRING_DATASOURCE_PASSWORD: CHANGE_ME
